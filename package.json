{
    "name": "bweb",
    "version": "1.4.1",
    "description": "Video downloader powered by yt-dlp",
    "main": "src/main/main.js",
    "author": "Baba",
    "license": "MIT",
    "private": true,
    "scripts": {
        "postinstall": "node scripts/postinstall.js",
        "dev": "DEV_MODE=1 electron .",
        "dev:win": "set DEV_MODE=1 && electron .",
        "start": "electron .",
        "build:mac": "electron-builder --mac",
        "build:win": "electron-builder --win --x64",
        "build:linux": "electron-builder --linux --x64",
        "build:all": "electron-builder --mac --win --linux",
        "release:mac": "electron-builder --mac --publish always",
        "release:win": "electron-builder --win --x64 --publish always",
        "release:linux": "electron-builder --linux --x64 --publish always",
        "release:all": "node scripts/release-all.js"
    },
    "build": {
        "publish": {
            "provider": "github",
            "owner": "CellPod",
            "repo": "bweb"
        },
        "appId": "com.bweb.app",
        "productName": "bWeb",
        "copyright": "Copyright © 2026 Baba — based on ArcDLP by Archis (MIT)",
        "directories": {
            "output": "dist"
        },
        "files": [
            "src/**/*",
            "node_modules/**/*",
            "package.json"
        ],
        "afterPack": "./scripts/fix-ffmpeg-win.js",
        "mac": {
            "category": "public.app-category.utilities",
            "icon": "build/icon.icns",
            "target": [
                "dmg",
                "zip"
            ],
            "identity": null,
            "hardenedRuntime": false,
            "gatekeeperAssess": false,
            "extraResources": [
                {
                    "from": "bin/",
                    "to": "bin/",
                    "filter": [
                        "yt-dlp",
                        "deno"
                    ]
                },
                {
                    "from": "node_modules/ffmpeg-static/",
                    "to": "ffmpeg-static/",
                    "filter": [
                        "ffmpeg"
                    ]
                },
                {
                    "from": "resources/models/",
                    "to": "models/"
                },
                {
                    "from": "licenses/",
                    "to": "licenses/"
                }
            ],
            "extraFiles": [
                {
                    "from": "node_modules/electron-sparkle-updater/native/vendor/Sparkle.framework",
                    "to": "Frameworks/Sparkle.framework"
                }
            ],
            "files": [
                "src/**/*",
                "node_modules/**/*",
                "package.json",
                "!**/node_modules/electron-sparkle-updater/native/vendor/**",
                "!**/node_modules/electron-sparkle-updater/native/sparkle-chain.tar.xz"
            ],
            "asarUnpack": [
                "**/node_modules/electron-sparkle-updater/native/build/Release/*.node"
            ],
            "extendInfo": {
                "SUFeedURL": "https://github.com/CellPod/bweb/releases/latest/download/appcast.xml",
                "SUPublicEDKey": "6CtElULhDYjuHj8gWulXU31KQBJvdXzHutM3l970ohs=",
                "SUEnableInstallerLauncherService": false,
                "SUScheduledCheckInterval": 3600,
                "SUDeltaChainHistory": 6,
                "CFBundleLocalizations": [
                    "ar",
                    "ca",
                    "cs",
                    "da",
                    "de",
                    "el",
                    "es",
                    "fa",
                    "fi",
                    "fr",
                    "he",
                    "hr",
                    "hu",
                    "is",
                    "it",
                    "ja",
                    "ko",
                    "nb",
                    "nl",
                    "nn",
                    "pl",
                    "pt-BR",
                    "pt-PT",
                    "ro",
                    "ru",
                    "sk",
                    "sl",
                    "sv",
                    "th",
                    "tr",
                    "uk",
                    "vi",
                    "zh_CN",
                    "zh_HK",
                    "zh_TW"
                ]
            }
        },
        "win": {
            "icon": "build/icon.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "extraResources": [
                {
                    "from": "bin/",
                    "to": "bin/",
                    "filter": [
                        "yt-dlp.exe",
                        "deno.exe",
                        "WinSparkle.dll"
                    ]
                },
                {
                    "from": "node_modules/ffmpeg-static/",
                    "to": "ffmpeg-static/",
                    "filter": [
                        "ffmpeg.exe"
                    ]
                },
                {
                    "from": "resources/models/",
                    "to": "models/"
                },
                {
                    "from": "licenses/",
                    "to": "licenses/"
                }
            ]
        },
        "linux": {
            "icon": "build/icon.png",
            "target": "AppImage",
            "category": "Utility",
            "extraResources": [
                {
                    "from": "bin/",
                    "to": "bin/",
                    "filter": [
                        "yt-dlp",
                        "deno"
                    ]
                },
                {
                    "from": "node_modules/ffmpeg-static/",
                    "to": "ffmpeg-static/",
                    "filter": [
                        "ffmpeg"
                    ]
                },
                {
                    "from": "resources/models/",
                    "to": "models/"
                },
                {
                    "from": "licenses/",
                    "to": "licenses/"
                }
            ]
        },
        "nsis": {
            "oneClick": true,
            "perMachine": false,
            "allowToChangeInstallationDirectory": false,
            "deleteAppDataOnUninstall": true
        },
        "dmg": {
            "writeUpdateInfo": false
        },
        "asar": true,
        "asarUnpack": [
            "node_modules/ffmpeg-static/**",
            "node_modules/@jspawn/ghostscript-wasm/**",
            "node_modules/onnxruntime-node/**",
            "node_modules/sharp/**",
            "node_modules/@img/**",
            "node_modules/koffi/**",
            "node_modules/@koromix/**",
            "src/main/ghostscriptWorker.js"
        ]
    },
    "dependencies": {
        "@fontsource/inter": "^5.3.0",
        "@jspawn/ghostscript-wasm": "^0.0.2",
        "electron-sparkle-updater": "^0.5.0",
        "electron-store": "^11.0.2",
        "ffmpeg-static": "^5.3.0",
        "koffi": "^3.3.0",
        "onnxruntime-node": "^1.30.0",
        "pdf-lib": "^1.17.1",
        "qr-code-styling": "^1.9.2",
        "sharp": "^0.35.4"
    },
    "devDependencies": {
        "electron": "^43.7.1",
        "electron-builder": "^26.15.3",
        "playwright-core": "^1.63.0"
    }
}
