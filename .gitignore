# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# production
/dist

# downloads yt-dlp dependecy here
/bin

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for commiting if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.npm
TODO.md
graphify-out/

# playwright-cli session artifacts (snapshots/screenshots from manual testing)
/.playwright-cli
/.tmp

# ONNX model weights — too large for a normal git push (GitHub hard-blocks files over
# 100MB); withoutbg-open-weights.onnx alone is ~433MB. Fetch/place manually before
# packaging a release build — see src/main/bgRemover.js for the expected path.
/resources/models/*.onnx
